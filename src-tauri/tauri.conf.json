{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "FarReach",
  "version": "0.9.2-dev.1",
  "identifier": "com.farreach.client",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FarReach",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": [10, 10, 10, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rsipka/FarReach/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "publisher": "FarReach",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Alexander Nt. and FarReach contributors",
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "version": "0.9.2.1" },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    },
    "android": { "versionCode": 902001 },
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.farreach.client.metainfo.xml": "linux/com.farreach.client.metainfo.xml"
        }
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libappindicator3-1"],
        "files": {
          "/usr/share/metainfo/com.farreach.client.metainfo.xml": "linux/com.farreach.client.metainfo.xml"
        }
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libappindicator-gtk3"],
        "files": {
          "/usr/share/metainfo/com.farreach.client.metainfo.xml": "linux/com.farreach.client.metainfo.xml"
        }
      }
    }
  }
}
